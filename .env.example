# Required: server-side only. Never expose with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=

# Optional: OpenAI model for every agent (default: gpt-5.5).
# OPENAI_MODEL=gpt-5.5

# Optional alternative provider: if OPENAI_API_KEY is unset and this is set, agents run on Claude.
# ANTHROPIC_API_KEY=
# KEELCODE_MODEL=claude-opus-5-5
